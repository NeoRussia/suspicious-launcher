# build output
build/
build-*/
out/
dist/
*.class

# Gradle's own caches (they embed absolute paths from the machine that built)
.gradle/

# the jar build.ps1 copies beside the sources
launcher/suspicious-speculars-launcher.jar

# local test fixture (90 MB) and harness scratch
test-instance/
.scratch/
__pycache__/
*.pyc

# logs and editor state
*.log
.idea/
*.iml
.vscode/

# patch data: generated by patcher/bundle.py from the shader workspace and published to
# suspicious-speculars under patch/. It travels inside the built jar; it is not launcher source.
patcher/data/
patcher/data-bundle.zip
patcher/data-bundle.version
